{
  // Type-checks the web app's JavaScript (SOLAR-679 F16), run by `npm test` (tsc -p jsconfig.json).
  // Not strict: the files are plain JS; this catches calls to names and functions that do not
  // exist, wrong imports, and Supabase calls that don't match the database (database.types.ts).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "lib": ["dom", "dom.iterable", "es2023"],
    "types": [],
    "paths": { "react": ["./types/react.d.ts"], "react-dom/client": ["./types/react.d.ts"] }
  },
  "include": ["public/*.jsx", "public/sb.js", "types/*.d.ts"]
}
