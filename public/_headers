# Cloudflare Pages response headers (SOLAR-135). One rule for every path: Pages
# joins the values of two matching rules, and two CSPs would both be enforced.
# script-src has no 'unsafe-inline': page code lives in .js files, not <script> blocks.
# style-src keeps 'unsafe-inline' for the <style> blocks and style="" attributes.
# Google sign-in (accounts.google.com/gsi) needs script, style, frame and connect.
# script-src names the four pinned library files by full path, not their hosts (SOLAR-533): a new
# version or library needs its path added here.
# The bot check (Cloudflare Turnstile, SOLAR-533) needs script and frame from challenges.cloudflare.com.
# Permissions-Policy turns off what the app never asks for. Kept: fullscreen and screen-wake-lock
# (wall display), identity-credentials-get (Google sign-in). Pop-up alerts need no entry.
# Cloudflare Web Analytics: Cloudflare adds its beacon script and it reports to cloudflareinsights.com.
# /build/* sets only Cache-Control: its files are named after their content on Cloudflare
# (scripts/build-jsx.js), so a browser keeps them for a year (SOLAR-143). The host rules at
# the end set only X-Robots-Tag. Add any other header to /* alone.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com/react@18.3.1/umd/react.production.min.js https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.58.0/dist/umd/supabase.js https://cdn.jsdelivr.net/npm/posthog-js@1.438.12/dist/array.js https://accounts.google.com/gsi/client https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://pmakzojwhouamawgszrc.supabase.co wss://pmakzojwhouamawgszrc.supabase.co https://accounts.google.com/gsi/ https://cloudflareinsights.com https://eu.i.posthog.com; frame-src https://accounts.google.com/gsi/ https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), serial=(), usb=(), xr-spatial-tracking=(), fullscreen=(self), screen-wake-lock=(self), identity-credentials-get=(self "https://accounts.google.com")
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/build/*
  Cache-Control: public, max-age=31536000, immutable

# Every file here also answers on app., admin. and pages.dev. Search engines list only
# princesolarhub.co.za (SOLAR-527); the app pages already carry a noindex meta tag.
https://app.princesolarhub.co.za/*
  X-Robots-Tag: noindex

https://admin.princesolarhub.co.za/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
