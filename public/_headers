# Cloudflare Pages response headers (SOLAR-135). One rule for every path: Pages
# joins the values of two matching rules, and two CSPs would both be enforced.
# script-src has no 'unsafe-inline': page code lives in .js files, not <script> blocks.
# style-src keeps 'unsafe-inline' for the <style> blocks and style="" attributes.
# Google sign-in (accounts.google.com/gsi) needs script, style, frame and connect.
# Cloudflare Web Analytics: Cloudflare adds its beacon script and it reports to cloudflareinsights.com.
# /build/* is the only other rule and sets only Cache-Control: its files are named after their
# content on Cloudflare (scripts/build-jsx.js), so a browser keeps them for a year (SOLAR-143).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://accounts.google.com/gsi/client https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://pmakzojwhouamawgszrc.supabase.co wss://pmakzojwhouamawgszrc.supabase.co https://accounts.google.com/gsi/ https://cloudflareinsights.com https://eu.i.posthog.com; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/build/*
  Cache-Control: public, max-age=31536000, immutable
