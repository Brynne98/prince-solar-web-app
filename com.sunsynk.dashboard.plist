<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd service to keep the dashboard running 24/7 (auto-start + restart on crash).
     Install:  cp com.sunsynk.dashboard.plist ~/Library/LaunchAgents/
               launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sunsynk.dashboard.plist
     Restart:  launchctl kickstart -k gui/$(id -u)/com.sunsynk.dashboard
     Stop:     launchctl bootout gui/$(id -u)/com.sunsynk.dashboard
     Logs:     ~/Library/Logs/sunsynk-dashboard.log  (and .err)
     NOTE: node path below is nvm's v24.15.0 — update it if you change Node versions
           (find it with:  which node). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sunsynk.dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/brynneprince/.nvm/versions/node/v24.15.0/bin/node</string>
    <string>/Users/brynneprince/Projects/personal/sunsynk-dashboard/server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/brynneprince/Projects/personal/sunsynk-dashboard</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/brynneprince/Library/Logs/sunsynk-dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/brynneprince/Library/Logs/sunsynk-dashboard.err</string>
</dict>
</plist>
